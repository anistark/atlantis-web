<svg viewBox="0 0 24 24" class="flame" aria-hidden="true"><path fill="currentColor" d="M12.4 2c.7 3.2-1 5-2.7 6.8C8 10.6 6 12.6 6 15.6 6 19.2 8.7 22 12 22s6-2.8 6-6.4c0-2.7-1.4-4.8-2.8-6.2-.2 1.5-.9 2.6-2 3.1.4-3.9-.4-7.6-.8-10.5z" /><path fill="var(--flame-core)" d="M12.2 12.6c.3 1.5-.5 2.4-1.3 3.2-.6.6-1 1.3-1 2.2 0 1.4 1 2.5 2.1 2.5s2.1-1.1 2.1-2.5c0-1.5-.8-2.4-1.5-3.2-.2.5-.6.9-1 1 .4-1.2.9-2.2.6-3.2z" /></svg>
{%- endmacro %}

