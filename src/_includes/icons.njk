{#- The app's own marks, from src/components/Icons.tsx, so a page here is drawn the way it is there. -#}
{%- set svg = 'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"' -%}

