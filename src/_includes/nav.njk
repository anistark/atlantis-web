{%- from "icons.njk" import icon -%}
<header class="nav">
  <nav class="page nav-inner" aria-label="Main">
    <a class="brand" href="/" aria-label="{{ site.title }} home">
      <span class="logo"></span>
      <span class="brand-word">{{ site.title }}</span>
    </a>
    <ul class="nav-links">
      <li class="nav-optional"><a href="/#features">Features</a></li>
      <li class="nav-optional"><a href="/#faq">FAQ</a></li>
      <li><a href="/download/"{% if page.url == "/download/" %} aria-current="page"{% endif %}>Download</a></li>
    </ul>
    <button class="icon-button" type="button" data-theme-toggle aria-label="Switch to the light theme">
      {{ icon("sun", "theme-dark") }}
      {{ icon("moon", "theme-light") }}
    </button>
  </nav>
</header>
