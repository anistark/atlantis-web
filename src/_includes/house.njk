{#- The hero stage: the house seen from above, with the roster moving through it and the logbook beside it. js/main.js drives the agents and writes the log. Without it, or with reduced motion, the house holds still. -#}
{%- from "icons.njk" import icon -%}
<figure class="stage glass" data-house role="img" aria-label="The house: agents at their desks, in the kitchen, the game room and the garage, with a logbook of what each is doing">
  <div class="stage-bar">
    <span class="stage-title">{{ icon("oracle") }} Oracle</span>
    <span class="stage-status" data-house-status>5 agents, 3 working</span>
  </div>
  <div class="stage-body">
    <svg class="plan" viewBox="0 0 760 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <g class="plan-rooms">
        <rect x="16" y="16" width="300" height="224" rx="10" />
        <rect x="332" y="16" width="196" height="148" rx="10" />
        <rect x="544" y="16" width="200" height="224" rx="10" />
        <rect x="16" y="256" width="420" height="128" rx="10" />
        <rect x="452" y="256" width="292" height="128" rx="10" />
      </g>
      <g class="plan-labels">
        <text x="32" y="38">Study</text>
        <text x="348" y="38">Kitchen</text>
        <text x="560" y="38">Game room</text>
        <text x="32" y="278">Garage</text>
        <text x="468" y="278">Akashic Records</text>
      </g>
      <g class="plan-things">
        <rect x="40" y="60" width="56" height="26" rx="3" />
        <rect x="140" y="60" width="56" height="26" rx="3" />
        <rect x="240" y="60" width="56" height="26" rx="3" />
        <rect x="40" y="146" width="56" height="26" rx="3" />
        <rect x="140" y="146" width="56" height="26" rx="3" />
        <rect x="240" y="146" width="56" height="26" rx="3" />
        <rect x="348" y="52" width="164" height="16" rx="3" />
        <circle cx="430" cy="116" r="22" />
        <rect x="584" y="64" width="120" height="64" rx="8" />
        <rect x="568" y="196" width="152" height="22" rx="6" />
        <circle cx="226" cy="324" r="30" />
        <rect x="476" y="296" width="244" height="8" rx="2" />
        <rect x="476" y="320" width="244" height="8" rx="2" />
        <rect x="476" y="344" width="244" height="8" rx="2" />
      </g>
      <g data-house-agents>
        <g class="agent" data-agent="scribe" data-state="working" style="transform: translate(68px, 104px)">
          <circle class="agent-halo" r="13" />
          <circle class="agent-dot" r="5.5" />
          <text y="-14" text-anchor="middle">scribe</text>
        </g>
        <g class="agent" data-agent="scout" data-state="working" style="transform: translate(268px, 104px)">
          <circle class="agent-halo" r="13" />
          <circle class="agent-dot" r="5.5" />
          <text y="-14" text-anchor="middle">scout</text>
        </g>
        <g class="agent" data-agent="ledger" data-state="working" style="transform: translate(168px, 190px)">
          <circle class="agent-halo" r="13" />
          <circle class="agent-dot" r="5.5" />
          <text y="-14" text-anchor="middle">ledger</text>
        </g>
        <g class="agent" data-agent="atlas" data-state="idle" style="transform: translate(396px, 116px)">
          <circle class="agent-halo" r="13" />
          <circle class="agent-dot" r="5.5" />
          <text y="-14" text-anchor="middle">atlas</text>
        </g>
        <g class="agent" data-agent="echo" data-state="idle" style="transform: translate(620px, 207px)">
          <circle class="agent-halo" r="13" />
          <circle class="agent-dot" r="5.5" />
          <text y="-14" text-anchor="middle">echo</text>
        </g>
      </g>
    </svg>
    <div class="log" aria-hidden="true">
      <p class="log-head">{{ icon("records") }} Logbook</p>
      <ol class="log-lines" data-house-log>
        <li><span class="log-time">09:38</span><span><span class="log-who" data-state="working">ledger</span> read_file books/october.csv</span></li>
        <li><span class="log-time">09:36</span><span><span class="log-who" data-state="idle">atlas</span> took a break in the kitchen after 64k tokens</span></li>
        <li><span class="log-time">09:33</span><span><span class="log-who" data-state="working">scout</span> web_search "local model benchmarks"</span></li>
        <li><span class="log-time">09:31</span><span><span class="log-who" data-state="working">scribe</span> edit_file chapters/03.md</span></li>
        <li><span class="log-time">09:27</span><span><span class="log-who" data-state="idle">echo</span> got bored and went to the game room</span></li>
      </ol>
    </div>
  </div>
</figure>
